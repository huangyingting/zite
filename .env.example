# Database (SQLite for local development, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production example:
# DATABASE_URL="postgresql://zite:zite_password@localhost:5432/zite_prod?schema=public"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="zite-super-secret-jwt-signing-key-for-local-dev-2026"

# Pluggable AI Capability: "copilot-sdk" | "azure-openai" | "deterministic"
AI_PROVIDER="copilot-sdk"
COPILOT_MODEL="gpt-4.1"

# Azure OpenAI Configuration (used when AI_PROVIDER="azure-openai")
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-10-21"
